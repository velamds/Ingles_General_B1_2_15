k": "Correct!", "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}], "type": "RSLT", "template_override": 1}, {"id": 11, "stimuli_ids": [], "questions": [{"_data": [{"type": "question", "contents": [{"content": "engenn7le15ob09re7pdf01.pdf", "type": "pdf"}]}], "responses": [{"id": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "correct": 1}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": " Write an advice column for the newspaper about how to deal with problems at work.", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}]}], "type": "DWS", "template_override": 1}], "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "template_override": 1, "id": 0}, {"id": 2, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": "engenn7le15ob09re2img05.jpg"}, {"text": "Dear Angela,<br/><br/>Thank you for forwarding your reference letter from the Cambridge Community Center.  I see that you are a very pro-active and talented person. I am sure you will do well in the field of journalism.", "id": 1, "time": "100", "image": "engenn7le15ob09re2img05.jpg"}, {"text": "You asked me to describe my career.  Let me tell you about the skill set required for journalism. First of all, you had better stay cool under pressure.  There are always lots of deadlines to respect. To be a journalist, you ought to be enthusiastic, well organized and a hard-worker. You had better be able to manage your time. You should understand what your priorities are at each moment. You might want to keep a notebook or recording device with you at all times. You never know when the next great idea is going to come along!", "id": 2, "time": "12000", "image": "engenn7le15ob09re2img01.jpg"}, {"text": "Is it a stressful job? It can be, but if you keep your head above water, you'll be fine.  I would just take one day at a time. I would try not to dwell on the difficult parts. Journalists are usually friendly people. You could ask people for help if you need it.<br/><br/>Good luck! Please feel free to contact me anytime!<br/><br/>Best,<br/>\nSally Davis", "id": 3, "time": "45000", "image": "engenn7le15ob09re2img05.jpg"}], "audiosrc": "engenn7le15ob09re2aud01", "coverimg": "engenn7le15ob09re2img05.jpg"}, "type": "slideshow"}], "_data": [], "type": "audio", "template_override": 1}]}]}