ata": [{"type": "question", "contents": [{"type": "text", "content": "Explain why you are suited to the job. (2 sentences):"}]}, {"type": "objective", "content": "secondary_3"}]}, {"responses": [{"selected": 0, "id": 0, "correct": 0, "_data": [{"type": "text", "content": ""}]}, {"selected": 0, "id": 1, "correct": 1, "_data": [{"type": "text", "content": ""}]}], "id": 5, "_data": [{"type": "question", "contents": [{"type": "text", "content": "Closing (2 sentences):"}]}, {"type": "objective", "content": "secondary_3"}]}], "type": "GWR", "_data": [{"type": "instructions", "contents": [{"type": "text", "content": "<span class=\"strong\">Now, it's your turn to write a cover letter.</span>"}, {"type": "text", "content": "<span class=\"italic\">Instructions:</span>"}, {"type": "text", "content": "<span class=\"bullet italic\">Imagine you have to write a cover letter for a job application.</span>"}, {"type": "text", "content": "<span class=\"bullet italic\">Decide on a job you would like to apply for.</span>"}, {"type": "text", "content": "<span class=\"bullet italic\">Think about the skills, education and experience required.</span>"}, {"type": "text", "content": "<span class=\"bullet italic\">Write a 100-120 word cover letter.</span>"}, {"type": "text", "content": "<span class=\"bullet italic\">Explain which job you are applying for.</span>"}, {"type": "text", "content": "<span class=\"bullet italic\">Include a summary of your education, skills and experience that match the job description.</span>"}, {"type": "text", "content": "<span class=\"bullet italic\">Explain why you are suited to the job. </span>"}, {"type": "text", "content": "<span class=\"bullet italic\">Finish by suggesting that the hiring manager review your r\u00e9sum\u00e9 as well as contact you about an interview.</span>"}, {"type": "text", "content": "<span class=\"bullet italic\">Include the Present Perfect Continuous tense and the Present Perfect tense. <span class=\"italic\">Example: I have been working in the sales department for two years.</span></span>"}, {"type": "text", "content": "<span class=\"bullet italic\">When you have typed in ALL your answers, click the <span class=\"strong\">Go to Writing Task</span> button.</span>"}, {"type": "text", "content": "<br/><span class=\"strong\">My Cover Letter</span>"}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Activity 3"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "You are done!", "incorrect_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}]}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Listening"}]}, {"type": "instructions", "contents": [{"type": "text", "content": "<span class=\"strong\">It's time to review your cover letter.</span>"}, {"type": "text", "content": "When you are writing a cover letter, remember to:"}, {"type": "text", "content": "<ul><li>Write in complete sentences.</li><li>Do not include your entire r\u00e9sum\u00e9 or talk about other job applications.</li><li>Use Present Perfect Continuous tense and the Present Perfect tense.</li><li>Be engaging!</li></ul>"}, {"type": "text", "content": "Proofread your cover letter for any spelling, grammar or punctuation errors."}, {"type": "text", "content": "Check your cover letter with your instructor."}, {"type": "text", "content": " Read your cover letter aloud to a partner."}, {"type": "text", "content": "Click the <span class=\"strong\">Submit</span> button to save your work."}]}, {"type": "grading_chart", "grading_contents": {"body": {"rows": [{"cells": [{"content_type": "text", "colspan": 1, "element": "th", "content": ""}, {"content_type": "text", "element": "th", "colspan": 1, "points": "20", "content": [" "]}, {"content_type": "text", "element": "th", "colspan": 1, "poin