{"labs": [{"stimuli": [{"template_override": 1, "id": 0, "type": "welcome", "contents": [{}], "_data": []}, {"type": "audio", "contents": [{"type": "slideshow", "value": {"coverimg": "engenn7le15ob08re2img01.jpg", "images": [{"text": "", "id": 0, "image": "engenn7le15ob08re2img01.jpg", "time": "0"}, {"text": "January 11th, 2015<br/>163 Indigo Way<br/>Cambridge, Massachusetts, 34939<br/><br/>Jeremy Acton<br/>Human Resources Manager<br/>The Sommerville Gazette<br/>P.O. Box 403<br/>Sommerville, Massachusetts, 34920", "id": 1, "image": "engenn7le15ob08re2img01.jpg", "time": "100"}, {"text": "Dear Mr. Acton,<br/><br/>I am writing to apply for the entry-level journalist position in the news department at <span class = \"italic\">The Sommerville Gazette</span>. <br/><br/>I have been attending Western Weston College as a journalism student since last year and have been looking for an opportunity to develop my journalism skills in a fast-paced, dynamic environment. As a native of Sommerville, I would enjoy gaining this experience at the Gazette. I have always wanted to stay in the area where I grew up.", "id": 2, "image": "engenn7le15ob08re2img01.jpg", "time": "22000"}, {"text": "I have previously worked as an event coordinator and liaison officer at the Cambridge Community Center.  This position provided the opportunity for me to enhance my written communication skills and interact with different community groups.  The job also required a strong work ethic and attention to detail. I found the deadlines and responsibilities associated with this position both challenging and rewarding. Furthermore, I have always maintained strong ties with the community and in particular, the businesses in the Sommerville/Cambridge area. My interest in current affairs and related experience makes me ideally suited to this job.", "id": 3, "image": "engenn7le15ob08re2img01.jpg", "time": "51000"}, {"text": "Thank you very much for your time and consideration. If I can provide you with any additional information, please feel free to contact me at (726) 545-8923. I will look forward to hearing from you in the near future.<br/><br/>Sincerely,<br/>Angela Weston", "id": 4, "image": "engenn7le15ob08re2img03.jpg", "time": "91000"}], "audiosrc": "engenn7le15ob08re2aud01"}}], "title": "", "template_override": 1, "id": 2, "_data": []}, {"type": "video", "contents": [{"type": "video", "value": {"video_src": "engenn7le15ob08re3vid01", "images": [{"text": "", "id": 0, "image": "", "time": "0"}, {"text": "Cover Letter", "id": 1, "image": "", "time": "6000"}, {"text": "<li>What is a cover letter?</li>", "id": 2, "image": "", "time": ""}, {"text": "<li>What should be included in a cover letter?</li>", "id": 3, "image": "", "time": "32000"}, {"text": "<li>Remember</li>", "id": 4, "image": "", "time": "165000"}]}}], "title": "", "template_override": 1, "id": 3, "_data": []}], "type": "scholar", "id": 0, "_data": [{"type": "lab_options", "contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}]}], "exercises": [{"stimuli_ids": [0], "id": 0, "_data": [{"type": "instructions", "contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Vocabulary and Grammar"}, {"type": "Learning Outcomes", "content": " I can write about jobs and work."}, {"type": "Learning Outcomes", "content": "I can write a cover letter. "}, {"type": "Learning Outcomes", "content": " I can write about things I have done or have been doing. "}, {"type": "Free Header Item", "content": " Do you know how to write a cover letter for a job application? "}, {"type": "Free Header Item", "content": " What should you include?"}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Welcome"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct", "incorrect_feedback": [{"type": "text", "content": "try again"}, {"type": "text", "content": "Maybe next time"}], "at